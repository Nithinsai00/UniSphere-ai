# ============================================================
# UniSphere AI — Environment Variables Example
# ============================================================

# Application Configuration
APP_NAME=UniSphere AI
APP_VERSION=1.0.0
DEBUG=False

# Database Configuration
# For local SQLite zero-dependency mode (default):
DATABASE_URL=sqlite:///./unisphere.db
# For PostgreSQL / Supabase in production:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# JWT Security
# Generate a secure 64-char random string in production:
SECRET_KEY=unisphere-hacxlerate-2026-super-secret-kpmg-key-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Bootstrap Administrator Credentials (Development Prototype)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@unisphere.edu
ADMIN_PASSWORD=Hope@50

# Default Scoring Engine Weights (Must sum to 1.0)
DEFAULT_WEIGHT_ACADEMIC=0.30
DEFAULT_WEIGHT_ATTENDANCE=0.20
DEFAULT_WEIGHT_LMS=0.15
DEFAULT_WEIGHT_PLACEMENT=0.20
DEFAULT_WEIGHT_SKILLS=0.15

# Default Risk Threshold Benchmarks
ATTENDANCE_THRESHOLD=75.0
ACADEMIC_CGPA_THRESHOLD=6.5
ACADEMIC_INTERNAL_THRESHOLD=60.0
PLACEMENT_THRESHOLD=60.0

# Optional External AI Assistant Integration (Google Gemini)
# Leave empty to use built-in rule-based analytical intelligence
GEMINI_API_KEY=
